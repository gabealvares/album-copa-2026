{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Cal Virgem",
	"slug": "cal",
	"blockTypes": [ "core/group", "core/columns", "core/column", "core/details", "core/quote" ],
	"styles": {
		"color": { "background": "var(--wp--preset--color--cal)", "text": "var(--wp--preset--color--fuligem)" },
		"elements": {
			"heading": { "color": { "text": "var(--wp--preset--color--anil)" } },
			"link": { "color": { "text": "var(--wp--preset--color--rubrica)" } }
		},
		"blocks": {
			"core/separator": { "color": { "text": "#C3C6CE", "background": "#C3C6CE" } }
		}
	}
}
